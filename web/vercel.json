{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/diff/accept",
      "destination": "/api/diff/accept"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
