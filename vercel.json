{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agent": {
      "root": "agent",
      "framework": "fastapi"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}