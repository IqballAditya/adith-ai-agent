# ==============================================================================
# ADITH AI STUDIO - Model API Keys Configuration
# ==============================================================================
# Masukkan API Key salah satu provider di bawah ini untuk membuka akses percakapan
# tanpa batas (open-domain chat) layaknya ChatGPT / Claude asli.
# Jika dibiarkan kosong, ADITH AI STUDIO akan berjalan menggunakan mesin lokal gratis.
# ==============================================================================

# 1. Google Gemini (GRATIS dari https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. OpenAI (GPT-4o dari https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 3. DeepSeek (DeepSeek-R1 dari https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# 4. Anthropic (Claude 3.5 Sonnet dari https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 5. Groq (Llama 3.3 70B Fast dari https://console.groq.com/)
GROQ_API_KEY=

# 6. Local Ollama (Jika menjalankan Ollama di komputer sendiri)
OLLAMA_BASE_URL=http://localhost:11434/v1
